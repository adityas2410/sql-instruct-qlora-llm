# Application
APP_NAME=sql-instruct-qlora-llm
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+psycopg://insurance_user:insurance_password@postgres:5432/insurance_fraud
DATABASE_SCHEMA=public
PGVECTOR_DIMENSION=128

# SQL safety
SQL_DEFAULT_LIMIT=100
SQL_MAX_LIMIT=1000
SQL_ALLOWED_SCHEMAS=public

# Falcon QLoRA SQL model
SQL_MODEL_BASE_ID=tiiuae/falcon-11B
SQL_MODEL_ADAPTER_DIR=models/sql_lora_adapter
SQL_MODEL_OUTPUT_DIR=artifacts/sql_model
SQL_MODEL_USE_4BIT=true
SQL_MODEL_USE_WANDB=false
WANDB_PROJECT=insurance-sql-agent
WANDB_ENTITY=

# Custom Skip-Gram embedding model
EMBEDDING_DIMENSION=128
EMBEDDING_NEGATIVE_SAMPLES=5
EMBEDDING_EPOCHS=20
EMBEDDING_MIN_TOKEN_FREQUENCY=1
EMBEDDING_ARTIFACT_DIR=artifacts/embedding_model
CLAIM_VECTOR_OUTPUT_PATH=artifacts/claim_vectors

# Data paths
SAMPLE_DATA_PATH=data/sample/insurance_sample.json
GENERATED_DATA_DIR=data/generated

# Agent configuration
AGENT_MODEL_PROVIDER=local_falcon_adapter
AGENT_MAX_TOOL_CALLS=8
AGENT_REQUIRE_GROUNDED_EVIDENCE=true

# Protected model operations
MODEL_JOB_API_KEY=replace-with-local-secret
ENABLE_TRAINING_ENDPOINTS=false
