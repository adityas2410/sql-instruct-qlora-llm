# Application
APP_NAME=sql-instruct-qlora-llm
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+psycopg://insurance_user:insurance_password@postgres:5432/insurance_fraud
DATABASE_SCHEMA=public
PGVECTOR_DIMENSION=128

# SQL safety and execution
SQL_DEFAULT_LIMIT=100
SQL_MAX_LIMIT=1000
SQL_ALLOWED_SCHEMAS=public
SQL_EXECUTION_DEFAULT_LIMIT=100
SQL_EXECUTION_MAX_LIMIT=1000

# Falcon QLoRA SQL model
SQL_MODEL_BASE_ID=tiiuae/falcon-11B
SQL_MODEL_ADAPTER_DIR=models/sql_lora_adapter
SQL_MODEL_OUTPUT_DIR=artifacts/sql_model
SQL_TRAIN_JSONL_PATH=data/generated/sql_instruction_train.jsonl
SQL_EVAL_JSONL_PATH=data/generated/sql_instruction_eval.jsonl
SQL_MODEL_USE_4BIT=true
SQL_MODEL_USE_WANDB=false
WANDB_PROJECT=insurance-sql-agent
WANDB_ENTITY=

# Custom Skip-Gram embedding model
EMBEDDING_DIMENSION=128
EMBEDDING_NEGATIVE_SAMPLES=5
EMBEDDING_EPOCHS=20
EMBEDDING_MIN_TOKEN_FREQUENCY=1
EMBEDDING_BATCH_SIZE=512
EMBEDDING_LEARNING_RATE=0.001
EMBEDDING_RANDOM_SEED=2410
EMBEDDING_ARTIFACT_DIR=artifacts/embedding_model
EMBEDDING_VOCAB_PATH=artifacts/embedding_model/token_vocabulary.json
EMBEDDING_PREPROCESSING_METADATA_PATH=artifacts/embedding_model/preprocessing_metadata.json
EMBEDDING_CONFIG_PATH=artifacts/embedding_model/skipgram_config.json
EMBEDDING_TOKEN_EMBEDDINGS_PATH=artifacts/embedding_model/token_embeddings.pt
CLAIM_VECTOR_OUTPUT_PATH=artifacts/claim_vectors/claim_vectors.json

# Semantic search
SEMANTIC_SEARCH_DEFAULT_TOP_K=10
SEMANTIC_SEARCH_MAX_TOP_K=50

# Data paths
SAMPLE_DATA_PATH=data/sample/insurance_sample.json
GENERATED_DATA_DIR=data/generated

# Agent configuration
AGENT_FRAMEWORK=huggingface_smolagents
AGENT_MODEL_PROVIDER=local_falcon_adapter
AGENT_MAX_STEPS=6
AGENT_USE_BASE_TOOLS=false
AGENT_REQUIRE_GROUNDED_EVIDENCE=true

# Protected model operations
MODEL_JOB_API_KEY=replace-with-local-secret
ENABLE_TRAINING_ENDPOINTS=false
